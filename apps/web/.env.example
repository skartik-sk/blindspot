# Anonymizing network: sphinx (default, Sepolia) | tor | passthrough (NOT anonymous, dev only)
VITE_ANON_NETWORK=sphinx
# Tor only: comma-separated KPS gateway addresses ip:port:certhash (public demo gateway is often down)
# VITE_TOR_GATEWAYS=
# Our relay: blocks with compact receipts + PIR. Must be public https for mixnet exits
# (http://localhost:8787 works for local dev, fetched directly). Unset: blocks from publicnode, no PIR.
# VITE_RELAY_URL=https://your-relay.example
# Independent header anchor; must be a different operator from the block source
VITE_ANCHOR_URL=https://sepolia.gateway.tenderly.co
# One-off reads that name an address (send prep, lookups outside the PIR directory)
VITE_READ_URL=https://ethereum-sepolia-rpc.publicnode.com
# Private send route (a builder RPC). Mainnet: https://rpc.flashbots.net/fast. Sepolia has none as of Nov 2026;
# leave unset and the app offers the public route via the mixnet. The app checks the URL answers for this chain.
# VITE_SEND_URL=
# Landing page links (optional)
# VITE_REPO_URL=https://github.com/you/bina-pooche
# VITE_VIDEO_URL=https://youtu.be/...
