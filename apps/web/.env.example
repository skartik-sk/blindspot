# Anonymizing network: sphinx (default, Sepolia) | tor | passthrough (NOT anonymous, dev only)
VITE_ANON_NETWORK=sphinx
# Tor only: comma-separated KPS gateway addresses ip:port:certhash (public demo gateway is often down)
# VITE_TOR_GATEWAYS=
# VITE_TOR_LOG=info
# Block access list source: public https URL of our BAL relay once deployed (mixnet/Tor exits only reach
# https hosts on :443). Default: publicnode, which serves eth_getBlockAccessList directly.
VITE_RELAY_URL=https://ethereum-sepolia-rpc.publicnode.com
# Independent header anchor; must be a different operator from VITE_RELAY_URL
VITE_ANCHOR_URL=https://sepolia.gateway.tenderly.co
VITE_SEND_URL=https://ethereum-sepolia-rpc.publicnode.com
