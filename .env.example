# For docker compose (see docker-compose.yml). Both names need DNS A records pointing at this machine.
SITE_DOMAIN=blindspot.example.org
RELAY_DOMAIN=relay.blindspot.example.org
# Sepolia RPC the relay reads blocks from (must serve eth_getBlockAccessList).
UPSTREAM_RPC=https://ethereum-sepolia-rpc.publicnode.com
# Optional: a node whose txpool the relay snapshots for pending alerts.
PENDING_RPC=
# Optional: addresses always kept in the private-lookup directory, comma-separated.
PIR_SEED=
# 1 = enable the Spy panel's "normal wallet" demo lane (answers only about allowlisted demo contracts).
ENABLE_NAIVE=0
# Only with --profile tor: this machine's public IP, advertised by the Tor gateway (clients dial ip:12298:certhash).
PUBLIC_IP=
