{
  "name": "blindspot",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc -b",
    "relay": "bun run --cwd apps/relay start",
    "check": "bash scripts/check.sh",
    "pin": "bun run --cwd apps/web scripts/pin.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "dev": "bun scripts/dev.ts",
    "build": "bun run --cwd apps/web build -- --base /"
  },
  "devDependencies": {
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
